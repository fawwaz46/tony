---
import { lineLabel } from "../lib/diff";
import type { Span } from "../lib/diff";

interface Props {
  item: any;
  risk?: boolean;
  span: Span | null;
  /** Resolved in Python from the diff. This component never decides it. */
  tag: string;
}
const { item, risk = false, span, tag } = Astro.props;

const PANES = [
  ["prev", "Prev"],
  ["now", "New"],
  ["impact", "Changes"],
] as const;

const panes = PANES.filter(([key]) => item[key]).map(([key, label]) => ({
  key,
  label,
  text: item[key],
}));

// A plain addition has nothing to compare against — no tabs, just the text.
// Computed here because `<=` inside the markup parses as a tag.
const flat = panes.length <= 1;

// Groups the pane buttons to their bodies. Stable per render, never read back.
const gid = Math.random().toString(36).slice(2, 8);
---

{
  risk ? (
    <div class="ann risk">
      <p class="t">
        Potential risk<span class="ln">{lineLabel(span)}</span>
      </p>
      <p class="n">{item.text}</p>
    </div>
  ) : flat ? (
    <div class="ann">
      <p class="t">
        {item.title || "Note"}
        <span class="ln">{lineLabel(span)}</span>
      </p>
      <p class="n">{panes[0]?.text ?? item.note ?? ""}</p>
    </div>
  ) : (
    <div class="ann">
      <p class="t">
        {item.title || "Note"}
        <span class="k">{tag.toUpperCase()}</span>
        <span class="ln">{lineLabel(span)}</span>
      </p>
      <div class="tabs">
        {panes.map((p, i) => (
          <button class="pt" data-g={gid} data-p={p.key} aria-selected={i === 0 ? "true" : "false"}>
            {p.label}
          </button>
        ))}
      </div>
      {panes.map((p, i) => (
        <p class="n pane" data-g={gid} data-p={p.key} hidden={i !== 0}>
          {p.text}
        </p>
      ))}
    </div>
  )
}
