---
import { PHASE_LABEL } from "../lib/diff";

interface Props {
  walkthroughs: any[];
}
const { walkthroughs } = Astro.props;

// Every comparison lives here rather than in the markup: the Astro compiler
// reads `<=` inside a JSX expression as the start of a tag.
const prepared = walkthroughs.map((w, idx) => {
  const raw = w.steps ?? [];
  const seen: string[] = [];
  for (const st of raw) if (st.path && !seen.includes(st.path)) seen.push(st.path);
  const nNew = raw.filter((st: any) => (st.phase || "same") !== "same").length;

  const steps = raw.map((st: any) => {
    const win = st.window;
    const [hotStart, hotEnd] = win?.hot ?? [0, -1];
    return {
      ...st,
      phase: st.phase || "same",
      rows:
        win?.lines.map((text: string, n: number) => {
          const lineNo = win.start + n;
          return { lineNo, text, hot: lineNo >= hotStart && lineNo <= hotEnd };
        }) ?? [],
      state: Object.entries(st.state ?? {})
        .slice(0, 3)
        .map(([k, v]) => {
          const val = String(v);
          const arrow = val.includes("->");
          const [was, now] = arrow ? val.split("->") : ["", val];
          return { k, val, arrow, was: was.trim(), now: now.trim() };
        }),
    };
  });
  return { w, idx, steps, seen, nNew };
});
---

<div class="wintro">
  <p>
    <b>These are traces, not diagrams.</b> Each one follows a single real scenario from the moment
    it starts, one step at a time. The code shown is read straight from your files.
  </p>
  <p>
    Use <b>next</b> to advance. Before you press it, say what you think happens next — that guess is
    what makes the step stick.
  </p>
</div>

{
  prepared.map(({ w, idx, steps, seen, nNew }) => (
    <section class="wt" data-w={idx} data-n={steps.length}>
      <header class="wth">
        <p class="cap">
          [ walkthrough {String(idx + 1).padStart(2, "0")}
          {walkthroughs.length > 1 ? ` / ${String(walkthroughs.length).padStart(2, "0")}` : ""} ]
        </p>
        <h3>{w.title}</h3>
        <p class="trig">
          <span class="tl">Starts when</span>
          {w.trigger}
        </p>
        {w.whatChanged && (
          <p class="wchg">
            <span class="tl">What changed</span>
            {w.whatChanged}
          </p>
        )}
        <div class="covers">
          {seen.map((p) => (
            <span class="chip">{p.split("/").pop()}</span>
          ))}
          {nNew > 0 && (
            <span class="chip hot">
              {nNew} of {steps.length} steps are new
            </span>
          )}
        </div>
      </header>

      <div class="dots">
        {steps.map((st: any, i: number) => (
          <button
            class={`dot ${st.phase || "same"}`}
            data-w={idx}
            data-s={i}
            aria-label={`Step ${i + 1}`}
            aria-current={i === 0 ? "true" : undefined}
          >
            {String(i + 1).padStart(2, "0")}
          </button>
        ))}
      </div>

      <div class="panels">
        {steps.map((st: any, i: number) => (
          <div class={`stepPanel${i === 0 ? " on" : ""}`} data-w={idx} data-s={i}>
            <p class="say">
              {st.say}
              {PHASE_LABEL[st.phase] && <span class={`ph ${st.phase}`}>{PHASE_LABEL[st.phase]}</span>}
            </p>
            <div class="split">
              {st.rows.length > 0 ? (
                <div class="cw">
                  <div class="cwh">{st.path}</div>
                  <div class="hunk">
                    {st.rows.map((r: any) => (
                      <div class={`l c${r.hot ? " hot" : ""}`}>
                        <span class="g">{r.lineNo}</span>{r.text || " "}
                      </div>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="cw none">happens outside the codebase</div>
              )}
              {st.state.length > 0 && (
                <div class="state">
                  <p class="cap">[ state ]</p>
                  {st.state.map((s: any) => (
                    <div class="sv">
                      <span class="sk">{s.k}</span>
                      {s.arrow ? (
                        <Fragment>
                          <span class="was">{s.was}</span>
                          <span class="to">→</span>
                          <span class="now">{s.now}</span>
                        </Fragment>
                      ) : (
                        <span class="now">{s.val}</span>
                      )}
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        ))}
      </div>

      <div class="wtnav">
        <button class="wprev" data-w={idx} disabled>&#8249; back</button>
        <span class="wpos" data-w={idx}>step 1 of {steps.length}</span>
        <button class="wnext" data-w={idx}>next &#8250;</button>
      </div>
    </section>
  ))
}
