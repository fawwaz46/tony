---
/**
 * Page chrome: head, top bar, footer. Every page on the site uses it so the
 * signed-in state is shown in exactly one place.
 */
import { SESSION_COOKIE, userForSession } from "../server/db";
import "../styles.css";
import "../site.css";

interface Props {
  title: string;
  description?: string;
  wide?: boolean;
}
const { title, description = "", wide = false } = Astro.props;

// A page that renders the bar needs to know who is looking at it. Failing
// closed (logged out) keeps the site readable even if the database is down.
let user = null;
try {
  user = await userForSession(Astro.cookies.get(SESSION_COOKIE)?.value);
} catch {
  user = null;
}
const here = Astro.url.pathname + Astro.url.search;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="dark" />
  </head>
  <body>
    <div class="wrap" style={wide ? "max-width:88rem" : undefined}>
      <nav class="nav">
        <a class="brand" href="/">tony</a>
        <span class="spacer"></span>
        {
          user ? (
            <>
              <a class="link" href="/reviews">Reviews</a>
              <span class="who">
                {user.avatarUrl && <img src={user.avatarUrl} alt="" width="20" height="20" />}
                {user.login}
              </span>
              <form method="POST" action="/api/auth/signout">
                <input type="hidden" name="next" value="/" />
                <button class="plain" type="submit">Sign out</button>
              </form>
            </>
          ) : (
            /* Sign-in is hidden while publishing is off by default and the
               domain is pending a Safe Browsing review — the link led straight
               to a browser interstitial. The route still works for anyone who
               is already signed in, and for /reviews. */
            null
          )
        }
      </nav>

      <slot />

      <footer class="foot">
        <span>tony</span>
        <a href="/docs">Docs</a>
        <a href="/privacy">Privacy</a>
        <span class="spacer"></span>
        <span>Reviews are encrypted at rest. tony holds the key.</span>
      </footer>
    </div>
    <script>
      // Sections fade up as they come on screen, the same way content does
      // everywhere else on the site. The class is only ever added here, so a
      // page without script shows everything at once. The hero has motion of
      // its own and is left alone.
      const calm = matchMedia("(prefers-reduced-motion: reduce)").matches;
      const sections = [...document.querySelectorAll<HTMLElement>(".sec")];
      if (!calm && "IntersectionObserver" in window) {
        const seen = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add("in");
              seen.unobserve(e.target);
            }
          },
          // A share of the section rather than a margin off the viewport, so the
          // last one on the page can still be reached.
          { threshold: 0.1 },
        );
        for (const el of sections) {
          el.classList.add("reveal");
          seen.observe(el);
        }
      }
    </script>
  </body>
</html>
