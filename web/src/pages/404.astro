---
// Astro serves this for any unmatched path.
import Shell from "../layouts/Shell.astro";
---

<Shell title="Not found · tony">
  <section class="sec" style="border:0">
    <p class="cap">[ 404 ]</p>
    <h2 class="big">That page isn't here.</h2>
    <p class="body">
      If someone sent you a review link, check it copied in full.
    </p>
    <a class="btn quiet" href="/">Back to tony</a>
  </section>
</Shell>
