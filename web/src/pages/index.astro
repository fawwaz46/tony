---
/**
 * The front door.
 *
 * The demo section runs the real renderer over a real payload rather than
 * showing a screenshot, so it cannot drift from the product and needs no image
 * pipeline.
 */
import Shell from "../layouts/Shell.astro";
import review from "../fixtures/review.json";

export const prerender = false;

const error = Astro.url.searchParams.get("error");

---

<Shell
  title="tony"
  description="Ask your coding agent to review a branch. tony turns it into a page: every change explained, the blast radius, and steppable runtime walkthroughs."
>
  <section class="hero">
    <div class="hero-copy">
      <h1>Tired of reading diffs?<br />Try Tony.</h1>
      <p class="lede">
        I've been using AI to write code, and without reading the diff, I have no idea
        what's going on and lose control of my codebases. Reading English is easier than
        reading code, so naturally, I opted for that. Made this with the hopes of letting my
        agents run wild while I still understand what's happening. It's not perfect, but
        it's been useful for me and fun to build lol.
      </p>
      <p class="lede note">
        * Updates and improvements coming soon; excited to see how efficient I can get this.
        Reach out to me on X (<a href="https://x.com/46waz" rel="me">@46waz</a>) for access.
      </p>
      <p class="lede sign">Best,<br />Fawwaz</p>
      <div class="cta-row">
        <div class="cmd">
          <code
            ><span class="p">$ </span>curl -fsSL https://tony-cli.com/install.sh | sh</code
          >
          <button type="button" data-copy="curl -fsSL https://tony-cli.com/install.sh | sh">
            Copy
          </button>
        </div>
      </div>
    </div>
    {/* Terminal art, not an illustration: the review pages are made of these
        same glyphs. Empty on the server and filled by the script below, so
        there is nothing to see without JS and nothing to read aloud. */}
    <div class="hero-art"><pre class="orb" aria-hidden="true"></pre></div>
  </section>

  <section class="sec">
    <p class="cap">[ what you get ]</p>
    <h2 class="big">Three views of one change.</h2>
    <p class="body">
      Every review is one page with three tabs. The prose is written by a model that
      read your files; every line number, span, and changed/added tag is computed
      from the diff itself, so the explanation can drift but the code never can.
    </p>
    <div class="three">
      <div>
        <span class="n">[01]</span>
        <h3>File changes</h3>
        <p>
          The diff per file, with explanations sitting inline above the lines they
          describe. Modified code gets Prev / New / Changes panes so you can see what
          the behaviour used to be.
        </p>
      </div>
      <div>
        <span class="n">[02]</span>
        <h3>Blast radius</h3>
        <p>
          Files the change reaches that aren't in the diff. Each consumer is read and
          classified as breaks, behaves differently, or compatible, then shown at the
          exact line that depends on what moved.
        </p>
      </div>
      <div>
        <span class="n">[03]</span>
        <h3>How it works</h3>
        <p>
          A steppable trace of one real scenario, with the source read from your disk
          and a state table beside it. Built for the case where you don't yet have a
          model of how the thing runs.
        </p>
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ example ]</p>
    <h2 class="big">Check it out.</h2>
    <p class="body">
      A review of a real change to an open-source HTTP library, covering how the server
      handles a client that hangs up mid-connection. Switch the tabs, step through the
      walkthrough.
    </p>
    <div class="demo">
      <div class="demo-bar">
        <span class="dot3"><i></i><i></i><i></i></span>
        <span>httpx · origin/v1...HEAD</span>
        <span class="live">try the tabs</span>
      </div>
      <div class="demo-scroll"><div id="demo-root"></div></div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ using it ]</p>
    <h2 class="big">Set it up once. Then just ask.</h2>
    <p class="body">
      tony doesn't call a model. Your coding agent writes the review. tony hands it
      the diff, holds it to a standard, and turns the answer into a page you can send
      someone. There's no API key.
    </p>
    <div class="three">
      <div>
        <span class="n">[01]</span>
        <h3>Install</h3>
        <p style="margin-bottom:.75rem">Puts the <code>tony</code> command on your machine.</p>
        <div class="cmd">
          <code><span class="p">$ </span>curl -fsSL https://tony-cli.com/install.sh | sh</code>
        </div>
      </div>
      <div>
        <span class="n">[02]</span>
        <h3>Connect and sign in</h3>
        <p style="margin-bottom:.75rem">
          Registers tony with Claude Code, Cursor, Amp, Codex — whichever you have — then
          opens a browser once. <b>Restart your agent after</b>: it reads its list of
          tools only at startup.
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony connect &amp;&amp; tony login</code></div>
      </div>
      <div>
        <span class="n">[03]</span>
        <h3>Ask</h3>
        <p style="margin-bottom:.75rem">
          Not a command — say it however you would have anyway. The agent reads the
          changed files, writes the review, and hands you back a link.
        </p>
        <div class="cmd"><code><span class="p">&gt; </span>review this branch with tony</code></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ commands ]</p>
    <h2 class="big">Everything it does.</h2>
    <p class="body">
      Reviewing isn't in this list, because it isn't a command any more — you ask your
      agent. These are the things you run yourself, nearly all of them once.
    </p>
    <div class="three two">
      <div>
        <h3>Setup</h3>
        <div class="cmd"><code><span class="p">$ </span>tony connect</code></div>
        <p class="body">
          Connects tony to every agent it knows about. Name one — <code>claude</code>,
          <code>cursor</code>, <code>amp</code>, <code>codex</code> — to do just that one.
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony login</code></div>
        <p class="body">
          Opens a browser. The page tells you when your terminal is ready.
        </p>
      </div>
      <div>
        <h3>Housekeeping</h3>
        <div class="cmd"><code><span class="p">$ </span>tony --help</code></div>
        <p class="body">Every command and flag.</p>
        <div class="cmd"><code><span class="p">$ </span>tony update</code></div>
        <p class="body">
          Upgrade, using whichever installer you used. Every other command
          checks for a release in the background and says so.
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony logout</code></div>
        <p class="body">Revokes this machine's token, then forgets it locally.</p>
        <div class="cmd"><code><span class="p">$ </span>tony uninstall</code></div>
        <p class="body">Removes tony and everything it saved. It asks first.</p>
      </div>
    </div>
  </section>

  <script>
    import { renderReview } from "../renderer/render";
    import payload from "../fixtures/review.json";

    // The demo is the product, running. If it ever breaks, the page should not
    // pretend otherwise — but it also must not take the rest of the page down.
    const root = document.getElementById("demo-root");
    if (root) {
      try {
        renderReview(root, payload as any);
      } catch {
        root.innerHTML =
          '<div class="wrap"><p class="rstate">[ demo unavailable ]</p></div>';
      }
    }

    document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((b) => {
      b.addEventListener("click", async () => {
        await navigator.clipboard.writeText(b.dataset.copy!);
        const was = b.textContent;
        b.textContent = "Copied";
        setTimeout(() => (b.textContent = was), 1500);
      });
    });
  </script>
</Shell>

<script>
  /**
   * The hero's rotating torus — Andy Sloane's donut, in the ramp a diff is
   * already written in.
   *
   * Two rotations at different rates so it never repeats a pose, and a
   * z-buffer so the near surface hides the far one. Never drawn on a phone,
   * where the column is display:none and the work would be thrown away, and
   * frozen on one frame for anyone who asked for less motion. rAF handles the
   * rest: a hidden tab stops calling us, so a background page costs nothing.
   */
  const pre = document.querySelector(".orb");
  const wide = window.matchMedia("(min-width: 64rem)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (pre) {
    const COLS = 46, ROWS = 24;
    const RAMP = ".:-=+*#%@";
    const R1 = 1, R2 = 2, K2 = 5;
    // The scale that fits a torus of radius R1+R2 across COLS, eased in so a
    // full rotation never touches an edge and clips.
    const K1 = ((COLS * K2 * 3) / (8 * (R1 + R2))) * 0.86;

    const cells = new Array(ROWS * COLS);
    const depth = new Float32Array(ROWS * COLS);

    const frame = (A, B) => {
      cells.fill(" ");
      depth.fill(0);
      const cA = Math.cos(A), sA = Math.sin(A), cB = Math.cos(B), sB = Math.sin(B);
      for (let th = 0; th < 6.283; th += 0.07) {
        const ct = Math.cos(th), st = Math.sin(th);
        for (let ph = 0; ph < 6.283; ph += 0.02) {
          const cp = Math.cos(ph), sp = Math.sin(ph);
          const cx = R2 + R1 * ct, cy = R1 * st;
          const x = cx * (cB * cp + sA * sB * sp) - cy * cA * sB;
          const y = cx * (sB * cp - sA * cB * sp) + cy * cA * cB;
          const ooz = 1 / (K2 + cA * cx * sp + cy * sA);
          const col = Math.round(COLS / 2 + K1 * ooz * x);
          // Half scale vertically: a character cell is about twice as tall as
          // it is wide, and an unscaled y stretches the figure into an oval.
          const row = Math.round(ROWS / 2 - K1 * 0.5 * ooz * y);
          const lum = cp * ct * sB - cA * ct * sp - sA * st + cB * (cA * st - ct * sA * sp);
          if (lum > 0 && col >= 0 && col < COLS && row >= 0 && row < ROWS) {
            const i = row * COLS + col;
            if (ooz > depth[i]) {
              depth[i] = ooz;
              cells[i] = RAMP[Math.min(RAMP.length - 1, Math.round(lum * 6))];
            }
          }
        }
      }
      let out = "";
      for (let r = 0; r < ROWS; r++) out += cells.slice(r * COLS, (r + 1) * COLS).join("") + "\n";
      return out;
    };

    let A = 0.9, B = 0.4, last = 0, running = false;

    const tick = (now) => {
      if (!running) return;
      // ~24fps. Faster buys nothing on a figure this coarse and costs battery.
      if (now - last > 42) {
        last = now;
        A += 0.05;
        B += 0.022;
        pre.textContent = frame(A, B);
      }
      requestAnimationFrame(tick);
    };

    const sync = () => {
      if (!wide.matches) {
        running = false;
        pre.textContent = "";
      } else if (still.matches) {
        running = false;
        pre.textContent = frame(A, B);
      } else if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    wide.addEventListener("change", sync);
    still.addEventListener("change", sync);
    sync();
  }
</script>
