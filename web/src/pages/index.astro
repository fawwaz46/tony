---
/**
 * The front door.
 *
 * The demo section runs the real renderer over a real payload rather than
 * showing a screenshot, so it cannot drift from the product and needs no image
 * pipeline.
 */
import Shell from "../layouts/Shell.astro";
import review from "../fixtures/review.json";

export const prerender = false;

const error = Astro.url.searchParams.get("error");

---

<Shell
  title="tony"
  description="Your coding agent reviews a branch. tony turns the review into a page you can actually read."
>
  <section class="hero">
    <div class="hero-copy">
      <h1>Tired of reading diffs?<br />Try Tony.</h1>
      <p class="lede">
        Fawwaz likes coding with AI. Fawwaz doesn’t like reading diffs. Fawwaz made a tool
        to make reading diffs more bearable. Fawwaz has friends with same issue. Fawwaz made
        tool public. Fawwaz likes iron man. Fawwaz named the tool after iron man. Say hi to
        Tony :)
      </p>
      <p class="lede note">
        follow me on X lmao <a href="https://x.com/46waz" rel="me">@46waz</a>
      </p>
      <div class="cta-row">
        <div class="cmd">
          <code
            ><span class="p">$ </span>curl -fsSL https://tony-cli.com/install.sh | sh</code
          >
          <button type="button" data-copy="curl -fsSL https://tony-cli.com/install.sh | sh">
            Copy
          </button>
        </div>
        {/* Only where the donut is drawn: on a phone there is nothing for it to do. */}
        <button type="button" class="btn hi-tony">Hi Tony</button>
      </div>
    </div>
    {/* Terminal art, not an illustration: the review pages are made of these
        same glyphs. Empty on the server and filled by the script below, so
        there is nothing to see without JS and nothing to read aloud. */}
    <div class="hero-art"><pre class="orb" aria-hidden="true"></pre></div>
  </section>

  <section class="sec">
    <p class="cap">[ what you get ]</p>
    <h2 class="big">Three views of one change.</h2>
    <p class="body">
      One page, three tabs. A model writes the explanations. Line numbers come straight
      from the diff, so they can't be wrong.
    </p>
    <div class="three">
      <div>
        <span class="n">[01]</span>
        <h3>File changes</h3>
        <p>Every file in the diff, with a note above each change: what it does now and what it did before.</p>
      </div>
      <div>
        <span class="n">[02]</span>
        <h3>Blast radius</h3>
        <p>Code outside the diff that uses what changed, marked broken, different, or fine.</p>
      </div>
      <div>
        <span class="n">[03]</span>
        <h3>How it works</h3>
        <p>Each flow the change touches, step by step, before and after.</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ example ]</p>
    <h2 class="big">Check it out.</h2>
    <p class="body">A real review of a small payments change. Click around.</p>
    <div class="demo">
      <div class="demo-bar">
        <span class="dot3"><i></i><i></i><i></i></span>
        <span>payments-api · main...HEAD</span>
        <span class="live">try the tabs</span>
      </div>
      <div class="demo-scroll"><div id="demo-root"></div></div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ using it ]</p>
    <h2 class="big">Set it up once. Then just ask.</h2>
    <p class="body">
      tony doesn't call a model. Your coding agent writes the review, and tony turns it
      into a page you can share. No API key.
    </p>
    <div class="three">
      <div>
        <span class="n">[01]</span>
        <h3>Install</h3>
        <div class="cmd">
          <code><span class="p">$ </span>curl -fsSL https://tony-cli.com/install.sh | sh</code>
        </div>
      </div>
      <div>
        <span class="n">[02]</span>
        <h3>Connect and sign in</h3>
        <p style="margin-bottom:.75rem">
          Works with Claude Code, Cursor, Amp and Codex. <b>Restart your agent after.</b>
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony connect &amp;&amp; tony login</code></div>
      </div>
      <div>
        <span class="n">[03]</span>
        <h3>Ask</h3>
        <p style="margin-bottom:.75rem">Ask your agent. You get a link back.</p>
        <div class="cmd"><code><span class="p">&gt; </span>review this branch with tony</code></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ commands ]</p>
    <h2 class="big">Everything it does.</h2>
    <p class="body">Your agent runs the reviews. These are the only commands you'll need.</p>
    <div class="three two">
      <div>
        <h3>Setup</h3>
        <div class="cmd"><code><span class="p">$ </span>tony connect</code></div>
        <p class="body">
          Connects every agent it finds. Add <code>claude</code>, <code>cursor</code>,
          <code>amp</code> or <code>codex</code> to pick one.
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony login</code></div>
        <p class="body">Signs you in through your browser.</p>
      </div>
      <div>
        <h3>Housekeeping</h3>
        <div class="cmd"><code><span class="p">$ </span>tony --help</code></div>
        <p class="body">All commands.</p>
        <div class="cmd"><code><span class="p">$ </span>tony update</code></div>
        <p class="body">Updates tony.</p>
        <div class="cmd"><code><span class="p">$ </span>tony logout</code></div>
        <p class="body">Signs this machine out.</p>
        <div class="cmd"><code><span class="p">$ </span>tony uninstall</code></div>
        <p class="body">Removes tony and everything it saved.</p>
      </div>
    </div>
  </section>

  <script>
    import { renderReview } from "../renderer/render";
    import payload from "../fixtures/review.json";

    // The demo is the product, running. If it ever breaks, the page should not
    // pretend otherwise — but it also must not take the rest of the page down.
    const root = document.getElementById("demo-root");
    if (root) {
      try {
        renderReview(root, payload as any);
      } catch {
        root.innerHTML =
          '<div class="wrap"><p class="rstate">[ demo unavailable ]</p></div>';
      }
    }

    document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((b) => {
      b.addEventListener("click", async () => {
        await navigator.clipboard.writeText(b.dataset.copy!);
        const was = b.textContent;
        b.textContent = "Copied";
        setTimeout(() => (b.textContent = was), 1500);
      });
    });
  </script>
</Shell>

<script>
  /**
   * The hero's rotating torus — Andy Sloane's donut, in the ramp a diff is
   * already written in.
   *
   * Two rotations at different rates so it never repeats a pose, and a
   * z-buffer so the near surface hides the far one. Never drawn on a phone,
   * where the column is display:none and the work would be thrown away, and
   * frozen on one frame for anyone who asked for less motion. rAF handles the
   * rest: a hidden tab stops calling us, so a background page costs nothing.
   */
  const pre = document.querySelector(".orb");
  const wide = window.matchMedia("(min-width: 64rem)");
  const still = window.matchMedia("(prefers-reduced-motion: reduce)");

  if (pre) {
    const RAMP = ".:-=+*#%@";
    // Marks a glyph as frosting. Not a character the ramp uses, so a cell is
    // frosted exactly when it starts with this.
    const FROST = "~";
    const R1 = 1, R2 = 2, K2 = 5;

    // The grid is sized from the column, not fixed: as many characters as fit
    // across it and as many rows as the hero is tall, so the figure fills the
    // half of the hero it was put there to fill at any desktop width.
    let COLS = 0, ROWS = 0, K1 = 0, ASPECT = 0.5, STEP = 1, CW = 0, LH = 0;
    let cells = [];
    let depth = new Float32Array(0);

    const measure = () => {
      const box = pre.parentElement;
      const probe = document.createElement("span");
      probe.textContent = "M".repeat(10);
      pre.appendChild(probe);
      const cw = probe.getBoundingClientRect().width / 10;
      pre.removeChild(probe);
      const lh = parseFloat(getComputedStyle(pre).lineHeight) || cw * 2;
      if (!cw || !box.clientWidth) return false;
      CW = cw;
      LH = lh;
      COLS = Math.max(20, Math.floor(box.clientWidth / cw));
      ROWS = Math.max(10, Math.floor(box.clientHeight / lh));
      // A cell is taller than it is wide; y is scaled by the real ratio so
      // the torus stays round whatever the font.
      ASPECT = cw / lh;
      // Fit whichever dimension is tighter, eased in so a full rotation never
      // touches an edge and clips.
      const fit = Math.min(COLS, ROWS / ASPECT);
      K1 = ((fit * K2 * 3) / (8 * (R1 + R2))) * 0.92;
      // Sample more finely as the grid grows, or a big torus shows holes.
      STEP = Math.min(1, 46 / fit);
      cells = new Array(ROWS * COLS);
      depth = new Float32Array(ROWS * COLS);
      return true;
    };

    const frame = (A, B) => {
      cells.fill(" ");
      depth.fill(0);
      const cA = Math.cos(A), sA = Math.sin(A), cB = Math.cos(B), sB = Math.sin(B);
      for (let th = 0; th < 6.283; th += 0.07 * STEP) {
        const ct = Math.cos(th), st = Math.sin(th);
        for (let ph = 0; ph < 6.283; ph += 0.02 * STEP) {
          const cp = Math.cos(ph), sp = Math.sin(ph);
          const cx = R2 + R1 * ct, cy = R1 * st;
          const x = cx * (cB * cp + sA * sB * sp) - cy * cA * sB;
          const y = cx * (sB * cp - sA * cB * sp) + cy * cA * cB;
          const ooz = 1 / (K2 + cA * cx * sp + cy * sA);
          const col = Math.round(COLS / 2 + K1 * ooz * x);
          // Scaled vertically by the cell's aspect: a character is about twice
          // as tall as it is wide, and an unscaled y stretches it into an oval.
          const row = Math.round(ROWS / 2 - K1 * ASPECT * ooz * y);
          const lum = cp * ct * sB - cA * ct * sp - sA * st + cB * (cA * st - ct * sA * sp);
          if (lum > 0 && col >= 0 && col < COLS && row >= 0 && row < ROWS) {
            const i = row * COLS + col;
            if (ooz > depth[i]) {
              depth[i] = ooz;
              // Frosting: the top of the tube (st > 0 in the donut's own
              // frame, so it turns with it), with an edge that drips down
              // the sides in a few places around the ring. A frosted cell
              // carries FROST in front of its glyph, which is how the flag
              // travels with the glyph through everything Hi Tony does to it.
              const edge = 0.35 - 0.6 * Math.pow(Math.max(0, Math.sin(ph * 7 + 1)), 4);
              cells[i] = (st > edge ? FROST : "") + RAMP[Math.min(RAMP.length - 1, Math.round(lum * 6))];
            }
          }
        }
      }
      return toText(cells);
    };

    let A = 0.9, B = 0.4, last = 0, running = false;

    // ---- Hi Tony ----------------------------------------------------------
    //
    // The donut trembles, blows apart, its glyphs stream into "hey", hold, and
    // stream back into the donut where it left off. One timeline, run inside
    // the same rAF loop as the spin, so a hidden tab pauses it like anything
    // else. Every glyph on screen is one of the donut's own, flying.

    const TREMBLE = 700, EXPLODE = 750, FORM = 1100, HOLD = 1400, RETURN = 1200;
    let hi = null; // { start, flyers, hey } while the greeting plays

    /**
     * The grid as markup: runs of frosting wrapped in one span each, so a
     * frame is a few dozen elements rather than one per glyph. Safe to set as
     * innerHTML because every glyph comes from RAMP or a space.
     */
    const toText = (grid, cols = COLS, rows = ROWS) => {
      let out = "";
      for (let r = 0; r < rows; r++) {
        let frosted = false;
        for (let c = 0; c < cols; c++) {
          const cell = grid[r * cols + c];
          const f = cell.length > 1;
          if (f !== frosted) {
            out += f ? '<span class="f">' : "</span>";
            frosted = f;
          }
          out += cell[cell.length - 1];
        }
        out += (frosted ? "</span>" : "") + "\n";
      }
      return out;
    };

    /** The non-blank cells of the donut as it is drawn right now. */
    const donutGlyphs = () => {
      const out = [];
      for (let i = 0; i < cells.length; i++) {
        if (cells[i] !== " ") out.push({ c: i % COLS, r: Math.floor(i / COLS), ch: cells[i] });
      }
      return out;
    };

    /**
     * "hey" as cells. Drawn on a canvas one pixel per character cell, with y
     * scaled by the cell's aspect so the letters come out the shape the font
     * drew them rather than twice as tall.
     */
    const heyGlyphs = () => {
      const canvas = document.createElement("canvas");
      canvas.width = COLS;
      canvas.height = ROWS;
      const g = canvas.getContext("2d", { willReadFrequently: true });
      const family = getComputedStyle(document.querySelector(".hero h1") || document.body).fontFamily;
      const tall = ROWS / ASPECT; // the grid's height, measured in cell widths
      g.setTransform(1, 0, 0, ASPECT, 0, 0);
      let size = tall * 0.62;
      g.font = `700 ${size}px ${family}`;
      const width = g.measureText("hey").width;
      if (width > COLS * 0.86) {
        size *= (COLS * 0.86) / width;
        g.font = `700 ${size}px ${family}`;
      }
      g.textAlign = "center";
      g.textBaseline = "middle";
      g.fillStyle = "#fff";
      g.fillText("hey", COLS / 2, tall * 0.46);
      const px = g.getImageData(0, 0, COLS, ROWS).data;
      const out = [];
      for (let i = 0; i < COLS * ROWS; i++) {
        const a = px[i * 4 + 3];
        if (a > 80) {
          const shade = 4 + Math.round((a / 255) * (RAMP.length - 5));
          out.push({ c: i % COLS, r: Math.floor(i / COLS), ch: RAMP[shade] });
        }
      }
      return out;
    };

    const shuffle = (xs) => {
      for (let i = xs.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [xs[i], xs[j]] = [xs[j], xs[i]];
      }
      return xs;
    };
    const ease = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const clamp01 = (t) => Math.max(0, Math.min(1, t));

    /** Pair every glyph of `from` with one of `to`, recycling the shorter side. */
    const pair = (from, to) => {
      const n = Math.max(from.length, to.length);
      const dst = shuffle(to.slice());
      return Array.from({ length: n }, (_, i) => ({
        from: from[i % from.length],
        to: dst[i % dst.length],
        delay: Math.random() * 0.28,
      }));
    };

    /**
     * The greeting plays on a stage: a see-through grid over the whole
     * viewport, so the burst is not clipped at the edge of the donut's column.
     * Its corner is snapped onto the donut's own cell grid, so a cell in the
     * box and the same cell on the stage are the same pixels, and nothing
     * jumps when the donut hands over to the stage and back.
     */
    const openStage = () => {
      const rect = pre.getBoundingClientRect();
      const offC = Math.floor(rect.left / CW), offR = Math.floor(rect.top / LH);
      const left = rect.left - offC * CW, top = rect.top - offR * LH;
      const width = document.documentElement.clientWidth - left;
      const height = window.innerHeight - top;
      const el = document.createElement("pre");
      el.className = "orb stage";
      el.setAttribute("aria-hidden", "true");
      Object.assign(el.style, {
        left: `${left + window.scrollX}px`, top: `${top + window.scrollY}px`,
        width: `${width}px`, height: `${height}px`,
      });
      document.body.appendChild(el);
      return { el, offC, offR, cols: Math.ceil(width / CW), rows: Math.ceil(height / LH) };
    };

    /** Put a glyph at donut-grid (c, r) — on the stage while one is up. */
    const plot = (grid, c, r, ch) => {
      const stage = hi?.stage;
      const col = Math.round(c) + (stage ? stage.offC : 0);
      const row = Math.round(r) + (stage ? stage.offR : 0);
      const cols = stage ? stage.cols : COLS, rows = stage ? stage.rows : ROWS;
      if (col >= 0 && col < cols && row >= 0 && row < rows) grid[row * cols + col] = ch;
    };

    /** One frame of the greeting at `t` ms in, or null when it is over. */
    const hiFrame = (t) => {
      const { cols, rows } = hi.stage;
      const grid = new Array(rows * cols).fill(" ");
      const paint = () => toText(grid, cols, rows);

      // Tremble: the donut keeps turning while its rows shake harder.
      if (t < TREMBLE) {
        A += 0.03;
        B += 0.013;
        frame(A, B);
        const amp = 0.4 + (t / TREMBLE) * 2.2;
        for (let r = 0; r < ROWS; r++) {
          const shift = Math.round((Math.random() * 2 - 1) * amp);
          for (let c = 0; c < COLS; c++) {
            const ch = cells[r * COLS + c];
            if (ch !== " ") plot(grid, c + shift, r + (Math.random() < 0.04 ? 1 : 0), ch);
          }
        }
        return paint();
      }

      // Everything after the tremble flies from one snapshot of the donut.
      if (!hi.flyers) {
        const burst = donutGlyphs().map((g) => {
          // Outward from the centre, measured square so the burst is round.
          const dx = g.c - COLS / 2, dy = (g.r - ROWS / 2) / ASPECT;
          const len = Math.hypot(dx, dy) || 1;
          // Measured against the stage, not the box: the far ones leave the
          // screen entirely and come back in for the letters.
          const speed = (0.3 + Math.random() * 1.2) * hi.stage.cols * 0.4;
          return { ...g, ex: g.c + (dx / len) * speed, ey: g.r + (dy / len) * speed * ASPECT };
        });
        hi.hey = heyGlyphs();
        hi.flyers = pair(burst, hi.hey);
      }

      // Explode: out from the centre, decelerating, glyphs flickering.
      let at = t - TREMBLE;
      if (at < EXPLODE) {
        const k = 1 - Math.pow(1 - at / EXPLODE, 3);
        for (const f of hi.flyers) {
          const p = f.from;
          const ch = Math.random() < 0.3 ? RAMP[Math.floor(Math.random() * RAMP.length)] : p.ch;
          plot(grid, p.c + (p.ex - p.c) * k, p.r + (p.ey - p.r) * k, ch);
        }
        return paint();
      }

      // Form: from wherever the burst left each glyph, into the letters.
      at -= EXPLODE;
      if (at < FORM) {
        for (const f of hi.flyers) {
          const k = ease(clamp01((at / FORM - f.delay) / (1 - f.delay)));
          const p = f.from, q = f.to;
          plot(grid, p.ex + (q.c - p.ex) * k, p.ey + (q.r - p.ey) * k, k > 0.92 ? q.ch : p.ch);
        }
        return paint();
      }

      // Hold: "hey", with a little shimmer so it reads as alive.
      at -= FORM;
      if (at < HOLD) {
        for (const g of hi.hey) {
          const ch = Math.random() < 0.04 ? RAMP[4 + Math.floor(Math.random() * 5)] : g.ch;
          plot(grid, g.c, g.r, ch);
        }
        return paint();
      }

      // Return: the letters stream back onto the donut's next pose.
      at -= HOLD;
      if (!hi.back) {
        frame(A + 0.05, B + 0.022);
        hi.back = pair(hi.hey, donutGlyphs());
      }
      if (at < RETURN) {
        for (const f of hi.back) {
          const k = ease(clamp01((at / RETURN - f.delay) / (1 - f.delay)));
          const p = f.from, q = f.to;
          plot(grid, p.c + (q.c - p.c) * k, p.r + (q.r - p.r) * k, k > 0.85 ? q.ch : p.ch);
        }
        return paint();
      }
      return null;
    };

    const tick = (now) => {
      if (!running) return;
      // ~24fps. Faster buys nothing on a figure this coarse and costs battery.
      if (now - last > 42) {
        last = now;
        if (hi) {
          if (!hi.start) hi.start = now;
          const text = hiFrame(now - hi.start);
          if (text !== null) {
            hi.stage.el.innerHTML = text;
            pre.textContent = "";
          } else {
            hi.stage.el.remove();
            hi = null;
            button?.removeAttribute("disabled");
          }
        }
        if (!hi) {
          A += 0.05;
          B += 0.022;
          pre.innerHTML = frame(A, B);
        }
      }
      requestAnimationFrame(tick);
    };

    const button = document.querySelector(".hi-tony");
    button?.addEventListener("click", () => {
      if (hi || !wide.matches) return;
      button.setAttribute("disabled", "");
      if (still.matches) {
        // No flying for anyone who asked for less motion: just the word, then
        // the donut back as it was.
        pre.innerHTML = toText((() => {
          const grid = new Array(ROWS * COLS).fill(" ");
          for (const g of heyGlyphs()) plot(grid, g.c, g.r, g.ch);
          return grid;
        })());
        setTimeout(() => {
          pre.innerHTML = frame(A, B);
          button.removeAttribute("disabled");
        }, HOLD + 400);
        return;
      }
      hi = { start: 0, flyers: null, hey: null, back: null, stage: openStage() };
    });

    const sync = () => {
      if (wide.matches && !measure()) return;
      if (!wide.matches) {
        running = false;
        pre.textContent = "";
      } else if (still.matches) {
        running = false;
        pre.innerHTML = frame(A, B);
      } else if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    // Re-fit when the column changes size. A resize mid-rotation just picks
    // up the new grid on the next frame.
    new ResizeObserver(() => {
      if (wide.matches && measure() && still.matches) pre.innerHTML = frame(A, B);
    }).observe(pre.parentElement);
    wide.addEventListener("change", sync);
    still.addEventListener("change", sync);
    sync();
  }
</script>
