---
/**
 * The front door.
 *
 * The demo section runs the real renderer over a real payload rather than
 * showing a screenshot, so it cannot drift from the product and needs no image
 * pipeline.
 */
import Shell from "../layouts/Shell.astro";
import review from "../fixtures/review.json";

export const prerender = false;

const error = Astro.url.searchParams.get("error");

---

<Shell
  title="tony"
  description="A CLI that explains a git diff to whoever now owns it — annotated changes, blast radius, and steppable runtime walkthroughs."
>
  <section class="hero">
    <h1>Tired of reading diffs?<br />Try Tony.</h1>
    <p class="lede">
      Asking Claude to explain its own work gets you a decent summary. Then you open the
      diff and it falls apart. Line by line, in code you've never read, in a codebase you
      might not know. tony assumes you know <b>nothing</b> about what was written. It reads
      the change against your actual repo and writes the explanation you'd want from the
      person who made it.
    </p>
    <div class="cta-row">
      <div class="cmd">
        <code
          ><span class="p">$ </span>curl -fsSL https://tony-cli.com/install.sh | sh</code
        >
        <button type="button" data-copy="curl -fsSL https://tony-cli.com/install.sh | sh">
          Copy
        </button>
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ what you get ]</p>
    <h2 class="big">Three views of one change.</h2>
    <p class="body">
      Every review is one page with three tabs. The prose is written by a model that
      read your files; every line number, span, and changed/added tag is computed
      from the diff itself, so the explanation can drift but the code never can.
    </p>
    <div class="three">
      <div>
        <span class="n">[01]</span>
        <h3>File changes</h3>
        <p>
          The diff per file, with explanations sitting inline above the lines they
          describe. Modified code gets Prev / New / Changes panes so you can see what
          the behaviour used to be.
        </p>
      </div>
      <div>
        <span class="n">[02]</span>
        <h3>Blast radius</h3>
        <p>
          Files the change reaches that aren't in the diff. Each consumer is read and
          classified as breaks, behaves differently, or compatible, then shown at the
          exact line that depends on what moved.
        </p>
      </div>
      <div>
        <span class="n">[03]</span>
        <h3>How it works</h3>
        <p>
          A steppable trace of one real scenario, with the source read from your disk
          and a state table beside it. Built for the case where you don't yet have a
          model of how the thing runs.
        </p>
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ example ]</p>
    <h2 class="big">Check it out.</h2>
    <p class="body">
      A review of a real change to an open-source HTTP library, covering how the server
      handles a client that hangs up mid-connection. Switch the tabs, step through the
      walkthrough.
    </p>
    <div class="demo">
      <div class="demo-bar">
        <span class="dot3"><i></i><i></i><i></i></span>
        <span>httpx · origin/v1...HEAD</span>
        <span class="live">try the tabs</span>
      </div>
      <div class="demo-scroll"><div id="demo-root"></div></div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ using it ]</p>
    <h2 class="big">How it works.</h2>
    <div class="three two">
      <div>
        <span class="n">[01]</span>
        <h3>Add a key</h3>
        <p style="margin-bottom:.75rem">
          tony reviews with Claude, so it needs an Anthropic API key. No account, no
          sign-up — the first run tells you where to get one and where to put it.
        </p>
        <div class="cmd">
          <code><span class="p">$ </span>echo 'ANTHROPIC_API_KEY=sk-ant-...' &gt;&gt; ~/.tony/.env</code>
        </div>
      </div>
      <div>
        <span class="n">[02]</span>
        <h3>Review</h3>
        <p style="margin-bottom:.75rem">
          Run it in any repo. tony reads the diff against your working tree, writes the
          review, and opens it. The page is one self-contained file in <code>.tony/</code>
          — it works offline, and nothing is uploaded.
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony main...my-branch</code></div>
      </div>
    </div>
  </section>

  <section class="sec">
    <p class="cap">[ where your code goes ]</p>
    <h2 class="big">Nowhere, mostly.</h2>
    <p class="body">
      Reviews stay on your machine. The page is one self-contained file written into
      <code>.tony/</code> in the repo you reviewed — it opens from disk, works offline,
      and keeps working after you uninstall tony.
    </p>
    <p class="body">
      The one thing that leaves is the diff itself, which goes to Anthropic so Claude can
      write the explanation. Nothing is uploaded here, and there is no account to make.
    </p>
  </section>

  <section class="sec">
    <p class="cap">[ commands ]</p>
    <h2 class="big">Everything it does.</h2>
    <div class="three">
      <div>
        <h3>Review</h3>
        <div class="cmd"><code><span class="p">$ </span>tony</code></div>
        <p class="body">
          The current repo, against its default branch. This is the whole product.
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony main...my-branch</code></div>
        <p class="body">A range, in git's own syntax.</p>
        <div class="cmd"><code><span class="p">$ </span>tony my-branch</code></div>
        <p class="body">Short for <code>my-branch...HEAD</code>.</p>
      </div>
      <div>
        <h3>Options</h3>
        <div class="cmd"><code><span class="p">$ </span>tony --no-open</code></div>
        <p class="body">Write the page without opening a browser.</p>
        <div class="cmd"><code><span class="p">$ </span>tony --stale</code></div>
        <p class="body">
          Review a branch that isn't checked out. Line numbers may not match, which is
          why tony refuses by default.
        </p>
        <div class="cmd"><code><span class="p">$ </span>tony --replay</code></div>
        <p class="body">Rebuild the last review's page without calling the API again.</p>
      </div>
      <div>
        <h3>Housekeeping</h3>
        <div class="cmd"><code><span class="p">$ </span>tony --help</code></div>
        <p class="body">Every command and flag.</p>
        <div class="cmd"><code><span class="p">$ </span>tony update</code></div>
        <p class="body">Upgrade, using whichever installer you used.</p>
        <div class="cmd"><code><span class="p">$ </span>tony uninstall</code></div>
        <p class="body">
          Removes tony, your key, and every saved review. It asks first.
        </p>
      </div>
    </div>
  </section>

  <script>
    import { renderReview } from "../renderer/render";
    import payload from "../fixtures/review.json";

    // The demo is the product, running. If it ever breaks, the page should not
    // pretend otherwise — but it also must not take the rest of the page down.
    const root = document.getElementById("demo-root");
    if (root) {
      try {
        renderReview(root, payload as any);
      } catch {
        root.innerHTML =
          '<div class="wrap"><p class="rstate">[ demo unavailable ]</p></div>';
      }
    }

    document.querySelectorAll<HTMLButtonElement>("button[data-copy]").forEach((b) => {
      b.addEventListener("click", async () => {
        await navigator.clipboard.writeText(b.dataset.copy!);
        const was = b.textContent;
        b.textContent = "Copied";
        setTimeout(() => (b.textContent = was), 1500);
      });
    });
  </script>
</Shell>
