---
/**
 * Pick a way in.
 *
 * The same page serves a browser login and the one `tony login` opens. In the
 * CLI case it carries the loopback port and nonce through to the provider
 * redirect, so whichever button gets clicked comes back to the waiting
 * terminal — the choice of provider is the user's, and the CLI does not need
 * to know which one they picked.
 *
 * Only providers this deployment has credentials for are shown. A button that
 * leads to a provider error page is worse than an absent button.
 *
 * Signing out of tony does not sign anyone out of the provider, and GitHub has
 * no `prompt=select_account` — an app you have already authorized redirects
 * straight through, so "use a different account" lands you back in the same
 * one. Google is fine (`prompt: select_account` in `providers.ts`). Rather
 * than send people to `github.com/logout`, which signs them out of GitHub
 * everywhere for the sake of a second tony account, the page hands them the
 * two things that actually work: this URL to open in a private window, where
 * there is no GitHub session to reuse, and the link to revoke tony's access.
 */
import Shell from "../layouts/Shell.astro";
import { SESSION_COOKIE, userForSession } from "../server/db";
import { clientId, configured, provider } from "../server/providers";
import { siteOrigin } from "../server/safe";

// Read at request time, not build time: this page's whole job is to act on its
// query string, and a prerendered copy would never see one.
export const prerender = false;

const params = Astro.url.searchParams;
const providers = configured();

// Who this browser already is, if anyone. Without this the page offers to sign
// you in while a session is already open, and the provider quietly reuses the
// account you happen to be logged into there — so `tony login` on a shared or
// second-account machine has no way to land anywhere else.
// Failing closed keeps the page usable if the database is down.
let current = null;
try {
  current = await userForSession(Astro.cookies.get(SESSION_COOKIE)?.value);
} catch {
  current = null;
}

// Validated the same way the start route validates them, so a malformed pair
// is dropped here rather than silently producing a login that never returns.
const port = /^\d{1,5}$/.test(params.get("cli") ?? "") ? params.get("cli")! : "";
const state = /^[a-f0-9]{16,64}$/.test(params.get("state") ?? "") ? params.get("state")! : "";
const forCli = Boolean(port && state);

// Where to revoke tony on GitHub. The id is public — it rides in every
// authorize redirect — and this is the only page that has a reason to show it.
const github = provider("github");
const githubId = github && configured().includes(github) ? clientId(github) : undefined;
const revokeUrl = githubId
  ? `https://github.com/settings/connections/applications/${githubId}`
  : "";

// The absolute form of this page, for pasting into a private window. Built
// from the proxied origin rather than `Astro.url.href` so it is the address
// the visitor actually typed, and it keeps the CLI's port and nonce so a
// private-window login still finds the waiting terminal.
const here = new URL(
  Astro.url.pathname + Astro.url.search,
  siteOrigin(Astro.request, Astro.url.origin),
).toString();

const errors: Record<string, string> = {
  login: "That sign-in did not complete. Nothing was saved — try again.",
  unavailable: "That option is not available on this deployment.",
  unconfigured: "This deployment has no sign-in configured yet.",
};
const error = errors[params.get("error") ?? ""] ?? "";

function href(id: string) {
  const url = new URLSearchParams({ provider: id });
  if (forCli) {
    url.set("cli", port);
    url.set("cliState", state);
  } else {
    const next = params.get("next");
    if (next) url.set("next", next);
  }
  return `/api/auth/start?${url}`;
}

const marks: Record<string, string> = {
  github: "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7 0-.7 0-.7 1.2.1 1.9 1.2 1.9 1.2 1 1.8 2.8 1.3 3.5 1 0-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2 0-.4-.5-1.6.2-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0C17.3 4.9 18.3 5.2 18.3 5.2c.7 1.6.2 2.8.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.5.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3",
  google: "M23.5 12.3c0-.8-.1-1.6-.2-2.3H12v4.5h6.4a5.5 5.5 0 0 1-2.4 3.6v3h3.9c2.2-2.1 3.6-5.2 3.6-8.8zM12 24c3.2 0 6-1.1 8-3l-3.9-3a7.2 7.2 0 0 1-10.7-3.8h-4v3.1A12 12 0 0 0 12 24zM5.3 14.2a7.1 7.1 0 0 1 0-4.6v-3h-4a12 12 0 0 0 0 10.7l4-3.1zM12 4.8c1.8 0 3.4.6 4.6 1.8l3.5-3.5A12 12 0 0 0 1.3 6.5l4 3.1A7.2 7.2 0 0 1 12 4.8z",
};
---

<Shell title="Sign in — tony" description="Sign in to tony.">
  <div class="auth">
    <p class="cap">{forCli ? "Signing in the tony CLI" : "Sign in"}</p>
    <h1>{forCli ? "Finish setting up tony" : "Sign in to tony"}</h1>
    <p class="sub">
      {forCli
        ? "Pick an account. When it is done, this page will tell you to go back to your terminal."
        : "Reviews you publish are kept under this account."}
    </p>

    {error && <p class="notice bad">{error}</p>}

    {
      current && (
        <div class="whoami">
          <p>
            This browser is signed in as <b>{current.login}</b>. Continuing below signs
            the {forCli ? "CLI" : "site"} in as them.
          </p>
          <form method="POST" action="/api/auth/signout">
            <input type="hidden" name="next" value={Astro.url.pathname + Astro.url.search} />
            <button class="btn quiet" type="submit">Use a different account</button>
          </form>
          <p class="fine">
            This only ends tony's session. If your provider signs you straight back in as
            the same person, open this page in a private window — there is no account
            cached there to reuse.
          </p>
          <p class="where"><code>{here}</code></p>
          {revokeUrl && (
            <p class="fine">
              Or <a href={revokeUrl} rel="noreferrer nofollow" target="_blank">revoke
              tony's access to GitHub</a>.
            </p>
          )}
        </div>
      )
    }

    {
      providers.length === 0 ? (
        <p class="notice bad">
          No sign-in provider is configured on this deployment yet.
        </p>
      ) : (
        <div class="ways">
          {providers.map((p) => (
            <a class="way" href={href(p.id)} rel="nofollow">
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
                <path fill="currentColor" d={marks[p.id] ?? ""} />
              </svg>
              Continue with {p.label}
            </a>
          ))}
        </div>
      )
    }

    <p class="fine">
      tony reads the account's name and avatar, and a verified email address if
      the provider gives one. It never asks for access to your code.
      <a href="/privacy">What is stored</a>.
    </p>
  </div>
</Shell>
