---
/**
 * Everything this account has published, newest first.
 *
 * The list is served from Postgres summary columns rather than by opening
 * every blob — the point of lifting intent/repo/range out at upload time.
 */
import Shell from "../layouts/Shell.astro";
import { SESSION_COOKIE, migrate, sql, userForSession } from "../server/db";
import { RETENTION_DAYS } from "../server/retention";

export const prerender = false;

let user = null;
let rows: any[] = [];
let tokens: any[] = [];
try {
  user = await userForSession(Astro.cookies.get(SESSION_COOKIE)?.value);
  if (user) {
    await migrate();
    rows = await sql`
      SELECT id, repo, range, intent, files, annotations, created_at
      FROM reviews
      WHERE user_id = ${user.id}
        AND created_at > now() - make_interval(days => ${RETENTION_DAYS}::int)
      ORDER BY created_at DESC LIMIT 200`;
    // Every live token, so any of them can be revoked: one on a laptop, or one
    // an approved agent holds in a sandbox somewhere.
    tokens = await sql`
      SELECT id, origin, label, created_at, last_used_at, expires_at
      FROM tokens WHERE user_id = ${user.id} AND expires_at > now()
      ORDER BY created_at DESC`;
  }
} catch {
  user = null;
}

// Publishing is off by default and the sign-in path currently lands on a
// browser interstitial, so this page must not offer one. Anyone already signed
// in still sees their reviews; everyone else is sent to the homepage rather
// than to a door that does not open.
if (!user) return Astro.redirect("/", 302);

const when = (d: string) =>
  new Date(d).toLocaleDateString(undefined, { month: "short", day: "numeric" });
const DAY = 24 * 60 * 60 * 1000;
const expires = (d: string) => when(new Date(new Date(d).getTime() + RETENTION_DAYS * DAY).toISOString());
---

<Shell title="Reviews · tony">
  {
    rows.length === 0 ? (
      <section class="sec" style="border:0">
        <p class="cap">[ reviews ]</p>
        <h2 class="big">Nothing published yet.</h2>
        <div class="empty">
          <p>
            Connect tony, then ask your agent for a review. It shows up here.
          </p>
          <div class="cmd" style="margin-bottom:.75rem">
            <code><span class="p">$ </span>tony connect &amp;&amp; tony login</code>
          </div>
          <div class="cmd">
            <code><span class="p">&gt; </span>review this branch with tony</code>
          </div>
        </div>
      </section>
    ) : (
      <section class="sec" style="border:0">
        <p class="cap">[ reviews · {rows.length} ]</p>
        <h2 class="big">Everything you've published.</h2>
        <p class="rnote">Reviews are deleted after {RETENTION_DAYS} days.</p>
        <div class="rlist">
          {rows.map((r: any, i: number) => (
            <div class="rrow" data-id={r.id}>
              <a class="rmain" href={`/r/${r.id}`} title={`Deleted automatically on ${expires(r.created_at)}`}>
                <span class="ix">[{String(i + 1).padStart(2, "0")}]</span>
                <span class="rrepo">{r.repo || "repo"}</span>
                <span class="rrange">{r.range}</span>
                <span class="rintent">{r.intent}</span>
                <span class="rwhen">{when(r.created_at)}</span>
              </a>
              <div class="racts">
                <button type="button" class="ract" data-copy-id={r.id}>Copy link</button>
                <button type="button" class="ract danger" data-del-id={r.id}>Delete</button>
              </div>
            </div>
          ))}
        </div>

        <script>
          // Delete is destructive and unrecoverable, so it confirms once and
          // says what it is deleting rather than "are you sure?".
          document.querySelectorAll<HTMLButtonElement>("[data-del-id]").forEach((b) => {
            b.addEventListener("click", async () => {
              const row = b.closest<HTMLElement>(".rrow")!;
              const name = row.querySelector(".rrepo")?.textContent ?? "this review";
              const range = row.querySelector(".rrange")?.textContent ?? "";
              if (!confirm(`Delete the review of ${name} ${range}? The link stops working.`)) return;

              b.disabled = true;
              b.textContent = "Deleting…";
              const resp = await fetch(`/api/reviews/${b.dataset.delId}`, { method: "DELETE" });
              if (resp.ok) {
                // Out the way content comes in: a short fade, then gone.
                row.classList.add("leaving");
                setTimeout(() => row.remove(), 350);
              } else {
                b.disabled = false;
                b.textContent = "Delete";
                alert("That could not be deleted. Try again.");
              }
            });
          });

          document.querySelectorAll<HTMLButtonElement>("[data-copy-id]").forEach((b) => {
            b.addEventListener("click", async () => {
              const url = `${location.origin}/r/${b.dataset.copyId}`;
              try {
                await navigator.clipboard.writeText(url);
                const was = b.textContent;
                b.textContent = "Copied";
                setTimeout(() => (b.textContent = was), 1500);
              } catch {
                prompt("Copy this link:", url);
              }
            });
          });
        </script>
      </section>
    )
  }

  <section class="sec" style="border:0">
    <p class="cap">[ logins · {tokens.length} ]</p>
    <p class="rnote">
      Each one can publish reviews to your account, nothing else. Revoke any you don't recognise.
    </p>
    {
      tokens.length === 0 ? (
        <p class="rnote">No CLI or agent is signed in.</p>
      ) : (
        <div class="rlist">
          {tokens.map((t: any) => (
            <div class="rrow" data-token={t.id}>
              <span class="rmain">
                <span class="rrepo">{t.origin === "link" ? (t.label || "Agent") : "CLI login"}</span>
                <span class="rintent">
                  {t.origin === "link" ? "approved" : "signed in"} {when(t.created_at)}
                  {t.last_used_at ? `, last used ${when(t.last_used_at)}` : ", never used"}
                  {`, expires ${when(t.expires_at)}`}
                </span>
              </span>
              <span class="racts">
                <button type="button" class="ract danger" data-revoke={t.id}>Revoke</button>
              </span>
            </div>
          ))}
        </div>
      )
    }
    <script>
      document.querySelectorAll<HTMLButtonElement>("[data-revoke]").forEach((b) => {
        b.addEventListener("click", async () => {
          b.disabled = true;
          const resp = await fetch(`/api/tokens/${b.dataset.revoke}`, { method: "DELETE" });
          const row = b.closest<HTMLElement>(".rrow");
          if (resp.ok && row) {
            row.classList.add("leaving");
            setTimeout(() => row.remove(), 350);
          } else {
            b.disabled = false;
            alert("That login could not be revoked. Try again.");
          }
        });
      });
    </script>
  </section>

  <section class="sec" style="border:0">
    <p class="cap">[ account ]</p>
    <p class="rnote">
      Deletes every review and signs out everywhere. Can't be undone.
    </p>
    <button type="button" class="ract danger" id="delete-account">Delete my account</button>
    <script>
      const b = document.getElementById("delete-account") as HTMLButtonElement;
      b.addEventListener("click", async () => {
        if (!confirm("Delete your account and every review in it? This can't be undone.")) return;
        b.disabled = true;
        b.textContent = "Deleting…";
        const resp = await fetch("/api/account", { method: "DELETE" });
        if (resp.ok) {
          location.href = "/";
        } else {
          b.disabled = false;
          b.textContent = "Delete my account";
          alert("Your account could not be deleted. Try again.");
        }
      });
    </script>
  </section>
</Shell>
